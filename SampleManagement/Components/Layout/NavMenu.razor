@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-scrollable @(isExpanded ? "sidebar-expanded" : "")">
    <div class="sidebar-header">
        <div class="header-content">
            <a class="stanley-icon" href=""></a>
            <a class="header-brand" href="">Foolproof Samples</a>
        </div>
    </div>

    <nav class="flex-column">
        <div class="nav-item navbar-toggler">
            <Button class="nav-link" @onclick="ToggleNavMenu" title="Navigation menu">
                <Icon Name="IconName.List" Color="IconColor.White" Class="toggler-icon" />
                <label>Collapse Navbar</label>
            </Button>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                <Icon Name="IconName.Pencil" />
                <label>Create Samples</label>
            </NavLink>
        </div>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="model-mappings" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                        <Icon Name="IconName.CloudArrowUpFill" />
                        <label>Upload Model <br/>Mappings</label>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="nav-item">
            <NavLink class="nav-link" href="foolproof-sheet" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                <Icon Name="IconName.CloudArrowUp" />
                <label>Upload Foolproof <br/>Sheets</label>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="request-remake" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                <Icon Name="IconName.ArrowClockwise" />
                <label>Request Sample<br />Remake</label>
            </NavLink>
        </div>

        <AuthorizeView Roles="Approver">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="approve-samples" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                        <Icon Name="IconName.Check2" />
                        <label>Approve Samples</label>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool isExpanded = false;

    /// <summary>
    /// Gets or sets the action to perform elsewhere when toggling
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnToggle { get; set; }

    private async Task ToggleNavMenu()
    {
        isExpanded = !isExpanded;
        await OnToggle.InvokeAsync(isExpanded);
    }

    private async Task CollapseNavMenu()
    {
        // Useful for mobile: close the menu automatically after clicking a link
        isExpanded = false;
        await OnToggle.InvokeAsync(isExpanded);
    }
}
