@page "/"
@inherits TableManager<Sample>

<PageTitle>Create New Sample</PageTitle>

<h2>Create & Print Samples</h2>

<div class="expandable-container">
    <div class="expandable-wrapper @(isFormExpanded ? "is-expanded" : "")">
        <div class="expandable-content">
            <div class="form-card" style="min-height: 322px">
                @if (editContext != null)
                {
                    <EditForm EditContext="editContext" OnSubmit="HandleSubmit" autocomplete="off">
                        <DataAnnotationsValidator />

                        @if (editContext != null)
                        {
                            @* Query the editContext for messages tied to the object container itself *@
                            var classErrors = editContext.GetValidationMessages(new FieldIdentifier(formData, string.Empty));

                            if (classErrors.Any())
                            {
                                <div class="alert alert-warning py-2 mt-2">
                                    @foreach (var error in classErrors)
                                    {
                                        <div><i class="bi bi-exclamation-triangle-fill me-2"></i>@error</div>
                                    }
                                </div>
                            }
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Model</label>
                                <InputText list="models" @bind-value="formData.Model" @bind-value:after="RefreshFilters"
                                    class="form-control" placeholder="Pick a model first to only see lines that run it..." />
                                <datalist id="models">
                                    @foreach (string m in availableModels)
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </datalist>
                                <ValidationMessage For="@(() => formData.Model)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Line Name</label>
                                <InputText list="lines" @bind-value="formData.Line" @bind-value:after="RefreshFilters"
                                    class="form-control" placeholder="...or pick a line first to only see the models that it runs" />
                                <datalist id="lines">
                                    @foreach (string l in availableLines)
                                    {
                                        <option value="@l">@l</option>
                                    }
                                </datalist>
                                <ValidationMessage For="@(() => formData.Line)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <label class="form-label">Dummy Sample #</label>
                                <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                                    @if (NotReadyForSampleNum)
                                    {
                                        <div class="text-muted small">Please enter valid model and line first.</div>
                                    }
                                    else if (availableSampleNums.Count == 0)
                                    {
                                        <div class="text-muted small">No dummy sample numbers are available for this model.</div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted mb-2">Select one or more dummy sample numbers to create.</div>
                                        <div class="form-check border-bottom pb-2 mb-2">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="dummy-sample-select-all"
                                                   checked="@(selectedDummySampleNums.Count > 0 && selectedDummySampleNums.Count == availableSampleNums.Count)"
                                                   @onchange="args => {
                                                        bool isSelected = (bool)(args.Value ?? false);
                                                        foreach (short num in availableSampleNums)
                                                        {
                                                            ToggleDummySampleSelection(num, isSelected);
                                                        }
                                                    }" />
                                            <label class="form-check-label" for="dummy-sample-select-all">Select all</label>
                                        </div>
                                        @foreach (short num in availableSampleNums)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="@($"dummy-sample-{num}")"
                                                       checked="@(selectedDummySampleNums.Contains(num))"
                                                       @onchange="args => ToggleDummySampleSelection(num, (bool)(args.Value ?? false))" />
                                                <label class="form-check-label" for="@($"dummy-sample-{num}")">@num</label>
                                            </div>
                                        }
                                    }
                                </div>
                                @if (!NotReadyForSampleNum && selectedDummySampleNums.Count > 0)
                                {
                                    <div class="form-text">Selected: @string.Join(", ", selectedDummySampleNums.OrderBy(num => num))</div>
                                }
                            </div>

                            <div class="col-md-8">
                                <label class="form-label">Associate Signature</label>
                                <InputNumber TValue="int?" @bind-value="formData.CreatorNum" class="form-control"
                                        placeholder=@(NotReadyForSignature ? "Please select one or more dummy sample numbers first" : "Enter your associate number")
                                        disabled=@NotReadyForSignature />
                                @if (!NotReadyForSignature)
                                {
                                    <ValidationMessage For="@(() => formData.CreatorNum)" />
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 mt-2">@errorMessage</div>
                        }

                        <div class="form-actions d-flex justify-content-center align-items-center">
                            <button type="button" class="btn btn-outline-secondary btn-lg me-2" @onclick="CloseForm">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-plus-lg"></i> Save Sample
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>

    <div class="expandable-wrapper @(!(isFormExpanded || printModeEngaged || isAwaitingPrint) ? "is-expanded" : "")">
        <div class="expandable-content centered-container">
            <button class="btn btn-success" @onclick="() => isFormExpanded=true">
                <Icon Name="IconName.PencilSquare" /> Create New Sample
            </button>
        </div>
    </div>
    <div class="expandable-wrapper @(isAwaitingPrint ? "is-expanded" : "")">
        <div class="expandable-content centered-container">
            <div class="form-card animate-fade-in text-center">
                <p>Sample <strong>#@justCreatedSample?.DummySampleNum</strong> created for
                <strong>@justCreatedSample?.Model</strong> on <strong>@justCreatedSample?.Line</strong>.</p>
                <p class="text-muted">Print it now?</p>
                <button class="btn btn-primary me-2" @onclick="HandlePrintJustCreated">
                    <Icon Name="IconName.Printer" /> Yes, print
                </button>
                <button class="btn btn-outline-secondary" @onclick="DismissPrintPrompt">
                    Not now
                </button>
            </div>
        </div>
    </div>
    <div class="expandable-wrapper @(printModeEngaged && !isPrinting ? "is-expanded" : "")">
        <div class="expandable-content centered-container">
            <h4>Select one or more samples, then press "Confirm Print" to confirm or "Cancel Print" to cancel.</h4>
        </div>
    </div>
    <div class="expandable-wrapper @(isPrinting ? "is-expanded" : "")" style="display: @(isPrinting ? "block" : "none");">
        @* Have to nest so grid can be used for expansion and flex can be used for centering *@
        <div class="d-flex justify-content-end pb-1">
            <Spinner Color="SpinnerColor.Primary" />
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-end mb-1">
        <span class="form-label mb-0 me-2">DPI: </span>
        <div class="me-2">
            <select @bind="printDpi" class="form-select" style="width: auto;" disabled="@isPrinting">
                @foreach (int dpi in Config.DpiToTemplatePath.Keys)
                {
                    <option value="@dpi">@dpi</option>
                }
            </select>
        </div>
        @if (printModeEngaged)
        {
            <button class="btn btn-danger me-2"
                    disabled="@(printCts == null && isPrinting)"
                    @onclick="isPrinting && printCts != null ? printCts.Cancel : TogglePrintMode">
                <Icon Name="IconName.XCircle" /> Cancel Print
            </button>
            <button class="btn btn-primary"
                    disabled="@((selectedForPrint?.Count ?? 0) == 0 || isPrinting)"
                    title="Send print request after selecting at least one sample"
                    @onclick="HandlePrint">
                <Icon Name="IconName.Printer" /> Confirm Print (@printDpi DPI)
            </button>
        }
        else
        {
            <button class="btn btn-primary"
                    @onclick="TogglePrintMode">
                <Icon Name="IconName.Printer" /> Enter Print Mode
            </button>
        }
    </div>
</div>

<div class="mb-1">
    @* Don't do anything in this file for expand (it's handled in UniversalTable), but provide a binding to show the button *@
    <TablePresenter T="Sample"
                    Base="this"
                    OnExpand="() => {}"
                    OnRemake="HandleNavigateToRemake"
                    OnPrint="args => HandlePrint(args)"
                    PrintModeEngaged="printModeEngaged"
                    @bind-SelectedForPrint="selectedForPrint" />
    @* OnPrint lambda necessary to disambiguate between methods *@
</div>
