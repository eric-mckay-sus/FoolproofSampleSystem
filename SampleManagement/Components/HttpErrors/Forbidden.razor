@using System.Reflection
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>403 Forbidden</PageTitle>

<div class="error-page-wrapper">
    <div class="container-sheet animate-fade-in">
        <h1 class="error-code forbidden-text">403</h1>
    <h2 class="error-title">Forbidden</h2>
    <p class="error-message">
        @if (requiredRoles.Count > 0)
        {
            <span>This page requires the following privilege(s): <strong>@string.Join(", ", requiredRoles)</strong>.</span>
        }
        else
        {
            <span>You do not have permission to access this page.</span>
        }
    </p>
    <div class="user-info">
        Logged in as: <strong>@username</strong>
    </div>
    <a href="/" class="btn btn-primary">Return to Home</a>
    </div>
</div>

@code {
    private string username = "User";
    private List<string> requiredRoles = [];

    [Parameter]
    public RouteData? TargetRouteData { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        username = authState.User.Identity?.Name ?? "User";

        DetermineRequiredRoles();
    }

    private void DetermineRequiredRoles()
    {
        if (TargetRouteData == null) return;

        // Get the Type of the razor component the user attempted to navigate to
        var targetPageType = TargetRouteData.PageType;

        // Pull the [Authorize] attributes from that page component
        var authorizeAttributes = targetPageType.GetCustomAttributes<AuthorizeAttribute>(inherit: true);

        foreach (var attr in authorizeAttributes)
        {
            if (!string.IsNullOrEmpty(attr.Roles))
            {
                var roles = attr.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                      .Select(r => r.Trim());

                foreach (var role in roles)
                {
                    if (!requiredRoles.Contains(role))
                    {
                        requiredRoles.Add(role);
                    }
                }
            }
        }
    }
}
